            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Beta\",\n  \"email\": \"admin.beta@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"admin\"\n}"
