  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Researcher",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has message', () => pm.expect(res.message).to.be.a('string'));",
                  "pm.test('Has user.id', () => pm.expect(res.user.id).to.be.a('number'));",
                  "pm.test('Has user.email', () => pm.expect(res.user.email).to.include('@'));",
                  "pm.test('Role is valid', () => pm.expect(['researcher','admin','reviewer','funding_authority']).to.include(res.user.role));",
                  "pm.test('No password in response', () => pm.expect(res.user).to.not.have.property('password'));",
                  "pm.test('No password_hash in response', () => pm.expect(res.user).to.not.have.property('password_hash'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Researcher Alpha\",\n  \"email\": \"researcher.alpha@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"researcher\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
