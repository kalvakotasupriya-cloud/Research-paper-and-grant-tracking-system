        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token is JWT format', () => pm.expect(res.token).to.match(/^[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+$/));",
                  "pm.test('Token is not empty', () => pm.expect(res.token).to.not.be.empty);",
                  "pm.test('User object present', () => pm.expect(res.user).to.be.an('object'));",
                  "pm.test('User id is number', () => pm.expect(res.user.id).to.be.a('number'));",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  pm.collectionVariables.set('userId', String(res.user.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin.beta@example.com\",\n  \"password\": \"Password@123\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has id', () => pm.expect(res.id).to.be.a('number'));",
                  "pm.test('Has email', () => pm.expect(res.email).to.include('@'));",
                  "pm.test('Has role', () => pm.expect(res.role).to.be.a('string'));",
